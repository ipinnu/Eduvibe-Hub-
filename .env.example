NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public site origin used in invite/recovery emails and OAuth redirects.
# Local browsing: http://localhost:3000
# Production host (required): https://eduvibehub.com.ng — never leave this empty/localhost on Vercel.
# If you send invites from your laptop, set this to https://eduvibehub.com.ng or the email will refuse to send.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ALLOW_LOCAL_AUTH_REDIRECTS=true

# Server-only. Required for tutor-admin account invitations (local and Vercel production).
# Never prefix this variable with NEXT_PUBLIC_ and never expose it to clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Dashboard → Authentication → URL Configuration (production):
#   Site URL: https://eduvibehub.com.ng
#   Redirect URLs: https://eduvibehub.com.ng/auth/callback
#                  http://localhost:3000/auth/callback  (optional, for local testing)
# If Redirect URLs do not match exactly, Supabase drops users on the Site URL homepage.

# Google Calendar OAuth (server-only except the site URL above).
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# A long random secret used to AES-encrypt stored Google access/refresh tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Simple transactional notifications. Verify the sender domain in Resend.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=EduVibe Hub <updates@your-domain.com>
